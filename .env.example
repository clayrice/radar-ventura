# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# Explicit opt-in to external delivery. Keep false during preview.
EMAIL_SEND_ENABLED=false
# Live mode never displays demo records. Set false when connecting Supabase.
DEMO_MODE=true
# Mantém a edição editorial local enquanto o pipeline diário ainda não publicou no banco.
EDITORIAL_PREVIEW=true
GOOGLE_AUTH_ENABLED=false

# Integração Asaas preparada. Ativar somente após validar no sandbox.
BILLING_ENABLED=false
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Instagram via API oficial com Instagram Login. A rotina é automática; false é somente kill switch.
INSTAGRAM_PUBLISH_ENABLED=true
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Versão suportada confirmada no painel Meta, por exemplo v25.0.
INSTAGRAM_API_VERSION=
# O fluxo exige imagem original da matéria; não há fallback tipográfico.

# Separate gate for free daily signup, confirmation and digest. Keep false until validation.
DAILY_EMAIL_SEND_ENABLED=false
