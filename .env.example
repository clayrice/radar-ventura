# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# Explicit opt-in to external delivery. Keep false during preview.
EMAIL_SEND_ENABLED=false
# Live mode never displays demo records. Set false when connecting Supabase.
DEMO_MODE=true

# Integração Asaas preparada. Ativar somente após validar no sandbox.
BILLING_ENABLED=false
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
